<Window x:Class="EllediTransfer.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EllediTransfer.Gui"
        Title="Elledi Transfer" Width="1280" Height="780" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Paper}"
        FontFamily="{StaticResource TextFont}" FontSize="13"
        Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/EllediTransfer.Gui;component/Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="TransferTemplate">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Dir" Text="{Binding DirectionGlyph}" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource ChannelPc}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource ChannelText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination}"/>
                <ProgressBar x:Name="Bar" Grid.Row="1" Grid.Column="1" Margin="0,6,0,5" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource ChannelPc}"/>
                <TextBlock x:Name="Detail" Grid.Row="2" Grid.Column="1" Text="{Binding Detail}" Foreground="{StaticResource ChannelMuted}" FontSize="11.5" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUpload}" Value="False">
                    <Setter TargetName="Dir" Property="Foreground" Value="{StaticResource ChannelServer}"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource ChannelServer}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource ChannelDanger}"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource ChannelDanger}"/>
                    <Setter TargetName="Dir" Property="Foreground" Value="{StaticResource ChannelDanger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Waiting">
                    <Setter TargetName="Bar" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DifferenceTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" Foreground="{Binding Brush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Action}" Foreground="{Binding Brush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Title bar: the app and the window buttons; each bank shows its own connection -->
        <Grid Grid.Row="0" Background="{StaticResource Paper}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,10,0"/>
                <TextBlock Text="Elledi Transfer" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Riduci a icona"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Ingrandisci"/>
                <Button Style="{StaticResource CloseChromeButton}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Chiudi"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="268"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Left bank: the PC by default, or a second server -->
            <local:FilePane x:Name="LeftPane" IsLeft="True"/>

            <!-- Channel: the direction of every move is chosen and watched here -->
            <Grid Grid.Column="1" Background="{StaticResource Channel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Margin="18,22,18,0">
                    <Button x:Name="UploadButton" Style="{StaticResource DirectionButton}" Background="{StaticResource PcFill}" Click="Upload_Click" IsEnabled="False"
                            AutomationProperties.Name="Invia al server">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="UploadTitle" Text="Invia al server" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UploadHint" Text="Seleziona file sul PC" FontSize="12" Opacity="0.8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="18"/>
                        </Grid>
                    </Button>
                    <Button x:Name="DownloadButton" Style="{StaticResource DirectionButton}" Background="{StaticResource ServerFill}" Margin="0,10,0,0" Click="Download_Click" IsEnabled="False"
                            AutomationProperties.Name="Scarica sul PC">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="DownloadTitle" Text="Scarica sul PC" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DownloadHint" Text="Seleziona file sul server" FontSize="12" Opacity="0.8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="SyncButton" Style="{StaticResource ChannelGhostButton}" Margin="0,10,0,0" Padding="14,10" HorizontalContentAlignment="Left" Click="Sync_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock x:Name="SyncTitle" Text="Sincronizza le due cartelle"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Transfer options, folded away until needed -->
                <StackPanel Grid.Row="1" Margin="18,14,18,0">
                    <ToggleButton x:Name="OptionsToggle" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="T" Text="Opzioni di trasferimento" Foreground="{StaticResource ChannelMuted}" FontSize="12"/>
                                    <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource ChannelMuted}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                                        <Setter TargetName="T" Property="Foreground" Value="{StaticResource ChannelText}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="T" Property="Foreground" Value="{StaticResource ChannelText}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <StackPanel x:Name="OptionsPanel" Margin="0,12,0,0" Visibility="{Binding IsChecked, ElementName=OptionsToggle, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="{StaticResource ChannelRaised}" CornerRadius="7" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeBinary" Style="{StaticResource ChannelSegment}" GroupName="Mode" Content="Binario" IsChecked="True" ToolTip="Copia i byte così come sono"/>
                                <RadioButton x:Name="ModeText" Style="{StaticResource ChannelSegment}" GroupName="Mode" Content="Testo" ToolTip="Converte i fine riga tra Windows e il server"/>
                                <RadioButton x:Name="ModeAuto" Style="{StaticResource ChannelSegment}" GroupName="Mode" Content="Automatico" ToolTip="Testo per .txt, .html, .xml e simili, binario per il resto"/>
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="PreserveTimeCheck" Style="{StaticResource ChannelCheckBox}" Content="Mantieni la data di modifica" IsChecked="True"/>
                        <CheckBox x:Name="MoveCheck" Style="{StaticResource ChannelCheckBox}" Content="Sposta invece di copiare"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Limite di velocità" Foreground="{StaticResource ChannelText}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="SpeedBox" Width="64" Margin="10,0,6,0" Padding="6,3" FontSize="12" Text="0" HorizontalContentAlignment="Right"
                                     Background="{StaticResource ChannelRaised}" Foreground="{StaticResource ChannelText}" BorderBrush="{StaticResource ChannelLine}" CaretBrush="{StaticResource ChannelText}"
                                     ToolTip="0 = nessun limite"/>
                            <TextBlock Text="KB/s" Foreground="{StaticResource ChannelMuted}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2" Margin="18,22,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Trasferimenti" Foreground="{StaticResource ChannelText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Style="{StaticResource ChannelGhostButton}" Padding="10,4" FontSize="12" Content="Annulla" Visibility="Collapsed" Click="Cancel_Click"/>
                        <Button x:Name="ClearButton" Style="{StaticResource ChannelGhostButton}" Padding="10,4" FontSize="12" Content="Pulisci elenco" Margin="6,0,0,0" Visibility="Collapsed" Click="Clear_Click"/>
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Row="2" Height="1" Fill="{StaticResource ChannelLine}" VerticalAlignment="Top" Margin="18,10,18,0"/>

                <ScrollViewer Grid.Row="3" Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="18,0,18,12">
                    <ItemsControl x:Name="TransferList" ItemTemplate="{StaticResource TransferTemplate}"/>
                </ScrollViewer>
                <TextBlock x:Name="QueueEmpty" Grid.Row="3" Margin="18,0,18,0" Foreground="{StaticResource ChannelMuted}" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                           Text="Scegli dei file su un lato e premi la direzione in cui spostarli, oppure trascinali da un lato all'altro."/>
            </Grid>

            <!-- Right bank: always a server -->
            <local:FilePane x:Name="RightPane" Grid.Column="2"/>
        </Grid>

        <!-- Status line -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Paper}">
            <TextBlock x:Name="StatusText" Margin="16,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Modal layer for prompts and synchronization -->
        <Grid x:Name="Overlay" Grid.RowSpan="3" Background="{StaticResource Scrim}" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.22" Color="{StaticResource InkColor}"/>
                </Border.Effect>
                <Grid>
                    <!-- Generic prompt: new folder, rename, delete -->
                    <StackPanel x:Name="PromptPanel" Width="440" Margin="26,24">
                        <TextBlock x:Name="PromptTitle" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PromptMessage" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBox x:Name="PromptInput" Margin="0,16,0,0" KeyDown="PromptInput_KeyDown"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button Style="{StaticResource OutlineButton}" Content="Annulla" Click="PromptCancel_Click" IsCancel="True"/>
                            <Button x:Name="PromptConfirm" Style="{StaticResource FilledButton}" Margin="8,0,0,0" Click="PromptConfirm_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Saving a file the session user may not write: ask for an account that can use sudo -->
                    <StackPanel x:Name="SudoPanel" Width="460" Margin="26,24" Visibility="Collapsed">
                        <TextBlock Text="Serve un utente amministratore" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SudoMessage" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="Utente che può usare sudo, oppure root" Style="{StaticResource FieldLabel}" Margin="0,18,0,5"/>
                        <TextBox x:Name="SudoUser" AutomationProperties.Name="Utente amministratore"/>
                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                        <PasswordBox x:Name="SudoPassword" AutomationProperties.Name="Password amministratore" KeyDown="SudoPassword_KeyDown"/>
                        <Border x:Name="SudoErrorBox" Visibility="Collapsed" Background="{StaticResource DangerSoft}" CornerRadius="7" Padding="12,10" Margin="0,14,0,0">
                            <TextBlock x:Name="SudoError" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Text="La password resta in memoria finché il file è aperto, così i salvataggi successivi non la richiedono. Non viene mai scritta su disco."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button Style="{StaticResource OutlineButton}" Content="Non salvare sul server" Click="SudoCancel_Click"/>
                            <Button x:Name="SudoConfirm" Style="{StaticResource FilledButton}" Content="Salva con sudo" Margin="8,0,0,0" Click="SudoConfirm_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Synchronization -->
                    <Grid x:Name="SyncPanel" Width="640" Margin="26,24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Sincronizza le due cartelle" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1" Margin="0,12,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Pc}"/>
                            <TextBlock x:Name="SyncLocalPath" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Text="&#xE774;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Server}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="SyncRemotePath" Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                        </Grid>
                        <StackPanel Grid.Row="2">
                            <RadioButton x:Name="SyncToServer" Style="{StaticResource Choice}" GroupName="Sync" IsChecked="True" Checked="SyncOption_Changed">
                                <StackPanel>
                                    <TextBlock Text="Aggiorna il server" FontWeight="SemiBold"/>
                                    <TextBlock Text="Carica sul server i file nuovi o modificati sul PC." Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SyncToPc" Style="{StaticResource Choice}" GroupName="Sync" Checked="SyncOption_Changed">
                                <StackPanel>
                                    <TextBlock Text="Aggiorna il PC" FontWeight="SemiBold"/>
                                    <TextBlock Text="Scarica sul PC i file nuovi o modificati sul server." Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SyncBoth" Style="{StaticResource Choice}" GroupName="Sync" Checked="SyncOption_Changed">
                                <StackPanel>
                                    <TextBlock Text="In entrambe le direzioni" FontWeight="SemiBold"/>
                                    <TextBlock Text="Per ogni file vince la versione più recente, su qualunque lato si trovi." Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <CheckBox x:Name="SyncDeleteCheck" Content="Elimina dalla destinazione i file che non esistono più nell'origine" Checked="SyncOption_Changed" Unchecked="SyncOption_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="Considera diverso un file se cambia" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Style="{StaticResource SegmentTrack}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="CriteriaTime" Style="{StaticResource Segment}" GroupName="Criteria" Content="la data" IsChecked="True" Checked="SyncOption_Changed"/>
                                        <RadioButton x:Name="CriteriaSize" Style="{StaticResource Segment}" GroupName="Criteria" Content="la dimensione" Checked="SyncOption_Changed"/>
                                        <RadioButton x:Name="CriteriaEither" Style="{StaticResource Segment}" GroupName="Criteria" Content="l'una o l'altra" Checked="SyncOption_Changed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Row="4" x:Name="SyncResultBox" Margin="0,18,0,0" Background="{StaticResource Paper}" CornerRadius="8" Padding="14,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="SyncSummary" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="SyncDifferences" ItemTemplate="{StaticResource DifferenceTemplate}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button Style="{StaticResource OutlineButton}" Content="Chiudi" Click="SyncClose_Click"/>
                            <Button x:Name="SyncCompareButton" Style="{StaticResource OutlineButton}" Content="Confronta" Margin="8,0,0,0" Click="SyncCompare_Click"/>
                            <Button x:Name="SyncRunButton" Style="{StaticResource FilledButton}" Background="{StaticResource Server}" Content="Sincronizza" Margin="8,0,0,0" IsEnabled="False" Click="SyncRun_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
