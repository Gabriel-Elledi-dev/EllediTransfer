<UserControl x:Class="EllediTransfer.Gui.FilePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EllediTransfer.Gui"
             Background="{StaticResource Surface}" AllowDrop="True"
             DragEnter="Pane_DragOver" DragOver="Pane_DragOver" DragLeave="Pane_DragLeave" Drop="Pane_Drop">

    <UserControl.Resources>
        <!-- One file row; the folder glyph and the selection tint carry the colour of this bank -->
        <DataTemplate x:Key="FileTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="128"/>
                    <ColumnDefinition Width="{Binding PermissionsWidth, RelativeSource={RelativeSource AncestorType=local:FilePane}}"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="G" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15"
                           Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=local:FilePane}}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                <TextBlock Grid.Column="4" Text="{Binding Permissions}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsContainer}" Value="False">
                    <Setter TargetName="G" Property="Foreground" Value="{StaticResource Muted}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="RowStyle" TargetType="ListViewItem" BasedOn="{StaticResource FileRowBase}">
            <Setter Property="Tag" Value="{Binding AccentSoftBrush, RelativeSource={RelativeSource AncestorType=local:FilePane}}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header: what this bank shows, and the actions on it -->
        <Grid x:Name="Header" Margin="22,18,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SideGlyph" Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="18" Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=local:FilePane}}" Margin="0,2,12,0"/>
                <TextBlock x:Name="TitleText" Text="Questo PC" Style="{StaticResource PaneTitle}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Left bank only: the PC (default) or a second server -->
            <Border x:Name="ModeSwitch" Grid.Column="1" Style="{StaticResource SegmentTrack}" Margin="12,0,8,0" Visibility="Collapsed" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModePc" Style="{StaticResource Segment}" Padding="10,4" IsChecked="True" Checked="Mode_Checked"
                                 ToolTip="Mostra i file di questo PC">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="PC"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModeServer" Style="{StaticResource Segment}" Padding="10,4" Checked="Mode_Checked"
                                 ToolTip="Apri qui un secondo server, per copiare file da un server all'altro">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Server"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="TerminalButton" Style="{StaticResource IconButton}" Content="&#xE756;" ToolTip="Apri un terminale su questo server (Ctrl+T)" Click="Terminal_Click" Visibility="Collapsed"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="Cartella superiore (Backspace)" Click="Up_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Aggiorna (F5)" Click="Refresh_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8F4;" ToolTip="Nuova cartella" Click="NewFolder_Click"/>
                <Button x:Name="DisconnectButton" Style="{StaticResource IconButton}" Content="&#xE7E8;" ToolTip="Disconnetti" Click="Disconnect_Click" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Connected server: who we are and how safely -->
            <StackPanel x:Name="SessionLine" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="30,6,0,0" Visibility="Collapsed">
                <TextBlock x:Name="SessionText" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                <Border x:Name="SecurityChip" Margin="10,0,0,0" CornerRadius="9" Padding="7,1,9,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SecurityGlyph" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,5,0"/>
                        <TextBlock x:Name="SecurityText" FontSize="11.5"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Browsing -->
        <Grid x:Name="BrowsePanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="PathBox" Style="{StaticResource PathBox}" Margin="16,6,16,8" KeyDown="PathBox_KeyDown" AutomationProperties.Name="Percorso"/>
            <Grid Grid.Row="1" Margin="18,0,18,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="128"/>
                    <ColumnDefinition Width="{Binding PermissionsWidth, RelativeSource={RelativeSource AncestorType=local:FilePane}}"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" x:Name="SortName" Style="{StaticResource ColumnHeader}" Content="Nome" Tag="Name" Click="Sort_Click"/>
                <Button Grid.Column="2" x:Name="SortSize" Style="{StaticResource ColumnHeader}" Content="Dimensione" Tag="Size" Click="Sort_Click" HorizontalContentAlignment="Right" Margin="0,0,16,0"/>
                <Button Grid.Column="3" x:Name="SortDate" Style="{StaticResource ColumnHeader}" Content="Modificato" Tag="Modified" Click="Sort_Click"/>
                <TextBlock Grid.Column="4" Text="Permessi" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <ListView x:Name="List" Grid.Row="2" Style="{StaticResource FileList}" ItemContainerStyle="{StaticResource RowStyle}"
                      ItemTemplate="{StaticResource FileTemplate}" AutomationProperties.Name="File"
                      MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"
                      PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove"
                      SelectionChanged="List_SelectionChanged"
                      IsTextSearchEnabled="False" PreviewTextInput="List_PreviewTextInput"/>
            <TextBlock x:Name="Footer" Grid.Row="3" Margin="28,8,28,12" Foreground="{StaticResource Muted}" FontSize="12"/>
        </Grid>

        <!-- Not connected: the empty bank invites a connection -->
        <ScrollViewer x:Name="ConnectPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel MaxWidth="420" Margin="40,24,40,32" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="24" Background="{Binding AccentSoftBrush, RelativeSource={RelativeSource AncestorType=local:FilePane}}" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="22" Foreground="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=local:FilePane}}" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="ConnectTitle" Text="Collegati a un server" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="0,18,0,6"/>
                <TextBlock x:Name="ConnectSubtitle" Text="I file del server compariranno qui, di fronte a quelli del PC." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,24"/>

                <TextBlock Text="Protocollo" Style="{StaticResource FieldLabel}"/>
                <Border Style="{StaticResource SegmentTrack}" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ProtoSftp" Style="{StaticResource Segment}" Content="SFTP" IsChecked="True" Checked="Protocol_Checked"/>
                        <RadioButton x:Name="ProtoFtp" Style="{StaticResource Segment}" Content="FTP" Checked="Protocol_Checked"/>
                        <RadioButton x:Name="ProtoFtps" Style="{StaticResource Segment}" Content="FTPS" Checked="Protocol_Checked" ToolTip="FTP con TLS esplicito"/>
                        <RadioButton x:Name="ProtoFtpsImplicit" Style="{StaticResource Segment}" Content="FTPS implicito" Checked="Protocol_Checked" ToolTip="FTP con TLS implicito, di solito porta 990"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Server" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HostBox" AutomationProperties.Name="Server" KeyDown="ConnectField_KeyDown"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Porta" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PortBox" Text="22" AutomationProperties.Name="Porta" KeyDown="ConnectField_KeyDown"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Utente" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UserBox" Margin="0,0,0,14" AutomationProperties.Name="Utente" KeyDown="ConnectField_KeyDown"/>

                <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,14" AutomationProperties.Name="Password" KeyDown="ConnectField_KeyDown"/>

                <StackPanel x:Name="KeyFileRow">
                    <TextBlock Text="Chiave privata, se il server la richiede" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="KeyFileBox" AutomationProperties.Name="File della chiave privata"/>
                        <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="Sfoglia" Margin="8,0,0,0" Padding="12,7" Click="BrowseKey_Click"/>
                    </Grid>
                </StackPanel>

                <Button x:Name="ConnectButton" Style="{StaticResource FilledButton}" Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=local:FilePane}}" HorizontalContentAlignment="Center" Margin="0,8,0,0" Click="Connect_Click">
                    <TextBlock x:Name="ConnectButtonText" Text="Connetti"/>
                </Button>

                <Border x:Name="ConnectErrorBox" Visibility="Collapsed" Background="{StaticResource DangerSoft}" CornerRadius="7" Padding="12,10" Margin="0,14,0,0">
                    <TextBlock x:Name="ConnectError" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
                </Border>

                <!-- First contact with an SSH server: show the key and let the user decide -->
                <Border x:Name="HostKeyBox" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Prima connessione a questo server" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"
                                   Text="Confronta l'impronta con quella fornita da chi gestisce il server. Se coincide, la salverò e la controllerò a ogni connessione."/>
                        <TextBox x:Name="HostKeyText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource FilledButton}" Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=local:FilePane}}" Content="Considera attendibile e connetti" Click="TrustHostKey_Click"/>
                            <Button Style="{StaticResource OutlineButton}" Content="Annulla" Margin="8,0,0,0" Click="RejectHostKey_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Rectangle x:Name="DropHint" Grid.RowSpan="2" Margin="8" RadiusX="10" RadiusY="10" StrokeThickness="2" StrokeDashArray="4 3"
                   Stroke="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=local:FilePane}}" Visibility="Collapsed" IsHitTestVisible="False"
                   Fill="{Binding AccentSoftBrush, RelativeSource={RelativeSource AncestorType=local:FilePane}}" Opacity="0.6"/>
    </Grid>
</UserControl>
